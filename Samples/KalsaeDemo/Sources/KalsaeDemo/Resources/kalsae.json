{
  "app": {
    "name": "kalsae Demo",
    "version": "0.1.0",
    "identifier": "dev.kalsae.demo"
  },
  "build": {
    "frontendDist": "Resources",
    "devServerURL": "about:blank"
  },
  "windows": [
    {
      "label": "main",
      "title": "Kalsae Demo",
      "width": 1024,
      "height": 720,
      "minWidth": 640,
      "minHeight": 480,
      "resizable": true,
      "decorations": true,
      "transparent": false,
      "fullscreen": false,
      "visible": true,
      "center": true,
      "alwaysOnTop": false
    }
  ],
  "deepLink": {
    "schemes": ["kalsae-demo"],
    "autoRegisterOnLaunch": false
  },
  "autostart": {
    "args": []
  },
  "security": {
    "csp": "default-src 'self' https://app.kalsae ks://app; script-src 'self' https://app.kalsae ks://app 'unsafe-inline'; style-src 'self' https://app.kalsae ks://app 'unsafe-inline'; img-src 'self' https://app.kalsae ks://app data:; connect-src 'self' https://app.kalsae ks://app",
    "commandAllowlist": [
      "greet", "ping",
      "app.showInfo", "app.openFile", "app.notify", "app.quit",
      "app.showWindow", "app.hideWindow",
      "app.contextMenu", "app.toggleAccelerator"
    ],
    "fs": {
      "allow": ["~/**", "%USERPROFILE%/**", "%TEMP%/**"],
      "deny": []
    },
    "shell": {
      "openExternalSchemes": ["http", "https", "mailto"],
      "showItemInFolder": true,
      "moveToTrash": true,
      "fsScope": {
        "allow": ["~/**", "%USERPROFILE%/**", "%TEMP%/**", "C:/**"],
        "deny": []
      }
    },
    "devtools": true
  }
}
